{
  "name": "blouppy",
  "description": "Blouppy, a blog on software engineering: architecture, security, testing, back end and front end.",
  "version": "2.0.0",
  "author": "Jimmy Boinembalome",
  "license": "MIT",
  "eslintConfig": {
    "extends": [
      "wesbos"
    ],
    "rules": {
      "react/prop-types": 0
    }
