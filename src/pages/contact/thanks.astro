---
import Layout from "../../layouts/Layout.astro";
import { CheckIcon } from "@heroicons/react/24/outline";
import { Link } from "../../components/link/Link";
---

<Layout title="Message sent" description="Your message has been sent." noindex>
  <div class="mx-auto flex max-w-xl flex-col items-center py-10 text-center sm:py-16">
    <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-soft text-accent" aria-hidden="true">
      <CheckIcon className="h-7 w-7" />
    </span>
    <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-heading sm:text-4xl">Message sent</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">Thanks for writing. I'll reply by email as soon as I can.</p>
    <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <Link to="/blog/" className="btn">Back to articles</Link>
      <Link to="/contact/" className="btn-outline">Send another message</Link>
    </div>
  </div>
</Layout>
